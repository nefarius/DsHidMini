<ui:FluentWindow
    x:Class="Nefarius.DsHidMini.ControlApp.Views.Windows.BluetoothDiagnosticWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:Nefarius.DsHidMini.ControlApp.Helpers"
    Title="{Binding Title}"
    Width="560"
    Height="560"
    MinWidth="460"
    MinHeight="420"
    d:DesignHeight="560"
    d:DesignWidth="560"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <helpers:BooleanToGlyphConverter x:Key="BooleanToGlyphConverter" />
        <helpers:DiagnosticStageToSeverityConverter x:Key="DiagnosticStageToSeverityConverter" />
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar
            Title="{Binding Title}"
            DockPanel.Dock="Top" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="This checks why a controller paired over USB does not connect over Bluetooth."
                    TextWrapping="Wrap" />

                <ui:InfoBar
                    Grid.Row="2"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding Stage, Converter={StaticResource DiagnosticStageToSeverityConverter}}"
                    Title="Current step" />

                <ItemsControl
                    Grid.Row="4"
                    ItemsSource="{Binding PreflightItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4,0,4" LastChildFill="True">
                                <ui:TextBlock
                                    Width="24"
                                    FontWeight="Bold"
                                    Text="{Binding Passed, Converter={StaticResource BooleanToGlyphConverter}}" />
                                <StackPanel>
                                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Grid.Row="6"
                    Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6"
                    Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ui:TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Verdict.LastSuccessfulMilestone, StringFormat='Last confirmed step: {0}'}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            Text="{Binding Verdict.Explanation}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding Verdict.RemediationAction, StringFormat='Next step: {0}'}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Row="8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding StartCommand}"
                        Content="Start check"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInverter}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        IsEnabled="{Binding IsBusy}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ExportBundleCommand}"
                        Content="Create diagnostic package"
                        IsEnabled="{Binding HasVerdict}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
