<ui:FluentWindow
    x:Class="Nefarius.DsHidMini.ControlApp.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Nefarius.DsHidMini.ControlApp.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    MinWidth="1100"
    MinHeight="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <DockPanel>
        <tray:NotifyIcon
            x:Name="AppNotifyIcon"
            Width="0"
            Height="0"
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Assets/FireShock.png"
            LeftClick="AppNotifyIcon_OnLeftClick"
            MenuOnRightClick="True"
            TooltipText="DsHidMini ControlApp">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Command="{Binding ViewModel.OpenFromTrayCommand}" Header="Open" />
                    <MenuItem Command="{Binding ViewModel.ExitFromTrayCommand}" Header="Exit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
        <DockPanel DockPanel.Dock="Top">
            <ui:Button
                Margin="10,0,0,0"
                Command="{Binding ViewModel.RestartAsAdminCommand}"
                Content="Restart 'As Administrator'"
                DockPanel.Dock="Left"
                Visibility="{Binding ViewModel.IsAppElevated, Converter={StaticResource BoolToVis_TC_FV}}" />
            <ui:TitleBar
                x:Name="TitleBar"
                Title="{Binding ViewModel.ApplicationTitle}"
                CloseWindowByDoubleClickOnIcon="False"
                DockPanel.Dock="Left">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/FireShock.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </DockPanel>

        <Grid>
            <ui:NavigationView
                x:Name="RootNavigation"
                Padding="10,0,10,0"
                FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
                FrameMargin="0"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="False"
                MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
                OpenPaneLength="100"
                PaneDisplayMode="Left">
                <ui:NavigationView.ContentOverlay>
                    <Grid>
                        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Margin="0" />
                    </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>

            <ui:ContentDialogHost x:Name="RootContentDialog" />
        </Grid>


    </DockPanel>
</ui:FluentWindow>