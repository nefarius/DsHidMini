                            <TextBlock Style="{StaticResource ControlCaption}" Text="✕" />
                            <TextBlock
                                Margin="0,0,0,-14"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource ValueLabel}"
                                Text="{Binding State.CrossPressure.Label}" />
                        </Grid>
                    </Grid>

                    <Border
                        Canvas.Left="318"
                        Canvas.Top="168"
                        Width="58"
                        Height="26">
