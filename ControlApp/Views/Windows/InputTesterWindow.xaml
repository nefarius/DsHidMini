                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Row="0"
                            Grid.Column="1">
                            <Ellipse Width="40" Height="40" Fill="#332ECC71">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="#2ECC71" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.Triangle}" Value="True">
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse
                                Width="28"
                                Height="28"
                                Fill="#2ECC71"
                                Opacity="{Binding State.TrianglePressure.Normalized}" />
                            <TextBlock Style="{StaticResource ControlCaption}" Text="△" />
                            <TextBlock
                                Margin="0,0,0,-14"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource ValueLabel}"
                                Text="{Binding State.TrianglePressure.Label}" />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0">
                            <Ellipse Width="40" Height="40" Fill="#33E91E8C">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="#E91E8C" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.Square}" Value="True">
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse
                                Width="28"
                                Height="28"
                                Fill="#E91E8C"
                                Opacity="{Binding State.SquarePressure.Normalized}" />
                            <TextBlock Style="{StaticResource ControlCaption}" Text="□" />
                            <TextBlock
                                Margin="0,0,0,-14"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource ValueLabel}"
                                Text="{Binding State.SquarePressure.Label}" />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                            Grid.Column="2">
                            <Ellipse Width="40" Height="40" Fill="#33E74C3C">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="#E74C3C" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.Circle}" Value="True">
                                                <Setter Property="StrokeThickness" Value="4" />
