                        Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                        StrokeThickness="2" />

                    <Grid
                        Canvas.Left="118"
                        Canvas.Top="8"
                        Width="86"
                        Height="56">
                        <Border Margin="8,0,8,22">
                            <Border.Style>
                                <Style BasedOn="{StaticResource PadBorder}" TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.L2}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
