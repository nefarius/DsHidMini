                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Opacity="{Binding State.L2Pressure.Normalized}"
                            RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding State.L2Pressure.Normalized}" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource ControlCaption}"
                            Text="L2" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Style="{StaticResource ValueLabel}"
                            Text="{Binding State.L2Pressure.Label}" />
                    </Grid>
                    <Grid
