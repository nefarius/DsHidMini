                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{Binding StatusText}"
                Severity="{Binding StatusSeverity}" />
            <Viewbox
                Grid.Row="2"
                Stretch="Uniform">
                <Canvas
