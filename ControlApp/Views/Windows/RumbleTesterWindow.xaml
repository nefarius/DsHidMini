<ui:FluentWindow
    x:Class="Nefarius.DsHidMini.ControlApp.Views.Windows.RumbleTesterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="520"
    Height="420"
    MinWidth="460"
    MinHeight="380"
    d:DesignHeight="420"
    d:DesignWidth="520"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <ui:TitleBar
            Title="{Binding Title}"
            DockPanel.Dock="Top" />
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{Binding StatusText}"
                Severity="{Binding StatusSeverity}" />
            <DockPanel Grid.Row="2" LastChildFill="True">
                <ui:TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    Text="Large motor" />
                <ui:TextBlock
                    Width="36"
                    VerticalAlignment="Center"
                    Text="{Binding LargeMotor, StringFormat={}{0:0}}"
                    TextAlignment="Right" />
                <Slider
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding LargeMotor}" />
            </DockPanel>
            <DockPanel Grid.Row="4" LastChildFill="True">
                <ui:TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    Text="Small motor" />
                <ui:TextBlock
                    Width="36"
                    VerticalAlignment="Center"
                    Text="{Binding SmallMotor, StringFormat={}{0:0}}"
                    TextAlignment="Right" />
                <Slider
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding SmallMotor}" />
            </DockPanel>
            <StackPanel
                Grid.Row="6"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding TestLargeCommand}"
                    Content="Test large" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding TestSmallCommand}"
                    Content="Test small" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding TestBothCommand}"
                    Content="Test both" />
                <ui:Button
                    Command="{Binding StopCommand}"
                    Content="Stop" />
            </StackPanel>
            <ui:TextBlock
                Grid.Row="8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="The selected HID mode does not change this path. Saved rumble settings can still scale, redirect, or mute the motors. Closing this window attempts to turn both motors off."
                TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</ui:FluentWindow>
