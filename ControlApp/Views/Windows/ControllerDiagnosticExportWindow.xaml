<ui:FluentWindow
    x:Class="Nefarius.DsHidMini.ControlApp.Views.Windows.ControllerDiagnosticExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="560"
    Height="460"
    MinWidth="480"
    MinHeight="400"
    d:DesignHeight="460"
    d:DesignWidth="560"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <ui:TitleBar
            Title="{Binding Title}"
            DockPanel.Dock="Top" />
        <StackPanel Margin="16">
            <ui:TextBlock
                FontTypography="Subtitle"
                Text="Export controller diagnostics" />
            <ui:TextBlock
                Margin="0,8,0,0"
                Text="Creates a ZIP with the controller's USB descriptors, feature reports, EEPROM pages and a short motion recording. Attach it to a bug report to help identify genuine and clone controllers."
                TextWrapping="Wrap" />
            <CheckBox
                Margin="0,12,0,0"
                Content="Mask Bluetooth addresses and the serial number (recommended)"
                IsChecked="{Binding Redact}"
                IsEnabled="{Binding CanChangeOptions}" />
            <CheckBox
                Margin="0,4,0,0"
                Content="Include a 15-second motion recording"
                IsChecked="{Binding IncludeLiveCapture}"
                IsEnabled="{Binding CanChangeOptions}" />
            <ui:InfoBar
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding StatusText}"
                Severity="Informational" />
            <ui:TextBlock
                Margin="0,12,0,0"
                FontTypography="BodyStrong"
                Text="{Binding InstructionText}"
                TextWrapping="Wrap" />
            <ProgressBar
                Margin="0,8,0,0"
                Maximum="100"
                Value="{Binding ProgressValue}" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ShowInFolderCommand}"
                    Content="Show in folder"
                    Visibility="{Binding HasExport, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsEnabled="{Binding IsRunning}" />
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding StartCommand}"
                    Content="Start export" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
