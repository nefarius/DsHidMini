<UserControl
    x:Class="Nefarius.DsHidMini.ControlApp.Views.UserControls.DeviceUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:deviceSettings="clr-namespace:Nefarius.DsHidMini.ControlApp.ViewModels.UserControls.DeviceSettings"
    xmlns:enums="clr-namespace:Nefarius.DsHidMini.ControlApp.Models.DshmConfigManager.Enums"
    xmlns:helpers="clr-namespace:Nefarius.DsHidMini.ControlApp.Helpers"
    xmlns:local="clr-namespace:Nefarius.DsHidMini.ControlApp.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:userControls="clr-namespace:Nefarius.DsHidMini.ControlApp.ViewModels.UserControls"
    d:DataContext="{d:DesignInstance userControls:DeviceViewModel,
	                                 IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Thickness x:Key="MyKey_NextLineSpacement" Bottom="10" />
        <Style x:Key="MyKey_InfoDescriptionTextbox" TargetType="ui:TextBlock">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MyKey_StatusSymbol" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="70" />
            <Setter Property="Width" Value="40" />
        </Style>
        <system:Double x:Key="MyKey_SymbolFontSize">25</system:Double>

        <Style x:Key="SettingsFieldLabel" TargetType="ui:TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="SettingsSliderLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsSliderValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Margin" Value="10,0,16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsSliderRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <DataTemplate x:Key="CemuhookModeSetting" DataType="{x:Type deviceSettings:DeviceSettingsViewModel}">
            <ui:Card
                Margin="0,0,0,14"
                Padding="20,18"
                DockPanel.Dock="Top"
                Visibility="{Binding IsGroupVisible, Converter={StaticResource BoolToVis_TV_FC}}">
                <DockPanel Margin="2,0">
                    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontTypography="Subtitle"
                            Text="{Binding Header}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ResetGroupToOriginalDefaultsCommand}"
                            Content="Reset"
                            Visibility="{Binding IsGroupLocked, Converter={StaticResource BoolToVis_TC_FV}}" />
                    </Grid>
                    <ContentControl
                        HorizontalAlignment="Stretch"
                        Content="{Binding}"
                        DockPanel.Dock="Top"
                        Visibility="{Binding IsGroupLocked, Converter={StaticResource BoolToVis_TC_FV}}" />
                    <ui:InfoBar
                        Title="Unavailable with the current configuration"
                        DockPanel.Dock="Top"
                        IsClosable="False"
                        IsOpen="{Binding IsGroupLocked}"
                        Message="{Binding LockReason}"
                        Severity="Informational" />
                </DockPanel>
            </ui:Card>
        </DataTemplate>

        <DataTemplate DataType="{x:Type deviceSettings:CemuhookUdpSettingsViewModel}">
            <StackPanel>
                <ui:ToggleSwitch
                    Margin="{StaticResource MyKey_NextLineSpacement}"
                    Content="Enable Cemuhook UDP server"
                    IsChecked="{Binding Enabled}" />

                <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}"
                           Visibility="{Binding Enabled, Converter={StaticResource BoolToVis_TV_FC}}">
                    <ui:TextBlock
                        Style="{StaticResource SettingsFieldLabel}"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="Listen address:" />
                    <ComboBox
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        MinWidth="250"
                        MaxWidth="500"
                        IsEditable="False"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ListenAddresses}"
                        SelectedItem="{Binding SelectedListenAddress, Mode=TwoWay}"
                        DropDownOpened="CemuhookListenAddress_DropDownOpened"
                        AutomationProperties.Name="Listen address" />
                </DockPanel>

                <StackPanel Margin="{StaticResource MyKey_NextLineSpacement}"
                           Visibility="{Binding Enabled, Converter={StaticResource BoolToVis_TV_FC}}">
                    <DockPanel>
                        <ui:TextBlock
                            Style="{StaticResource SettingsFieldLabel}"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="UDP Port:" />
                        <ui:NumberBox
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Minimum="1"
                            Maximum="65535"
                            ClearButtonEnabled="False"
                            Value="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                            Width="150" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Use different ports for multiple controllers" />
                </StackPanel>
                <ui:InfoBar
                    Margin="0,8,0,0"
                    Title="Cemuhook UDP server"
                    IsClosable="False"
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorMessage}"
                    Severity="Error" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type deviceSettings:MotionControlsSettingsViewModel}">
            <StackPanel>
                <Grid Style="{StaticResource SettingsSliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderLabel}"
                        Text="Kalman Filter Strength:" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderValue}"
                        Text="{Binding KalmanFilterStrengthDisplay}" />
                    <Slider
                        Grid.Column="2"
                        Height="24"
                        VerticalAlignment="Center"
                        Maximum="1.0"
                        Minimum="0.0"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        Value="{Binding KalmanFilterStrength}" />
                </Grid>

                <Grid Style="{StaticResource SettingsSliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderLabel}"
                        Text="Gyro Sensitivity:" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderValue}"
                        Text="{Binding GyroSensitivityDisplay}" />
                    <Slider
                        Grid.Column="2"
                        Height="24"
                        VerticalAlignment="Center"
                        Maximum="1.5"
                        Minimum="0.1"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        Value="{Binding GyroSensitivity}" />
                </Grid>

                <Grid Style="{StaticResource SettingsSliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderLabel}"
                        Text="Accelerometer Sensitivity:" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSliderValue}"
                        Text="{Binding AccelSensitivityDisplay}" />
                    <Slider
                        Grid.Column="2"
                        Height="24"
                        VerticalAlignment="Center"
                        Maximum="1.5"
                        Minimum="0.1"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        Value="{Binding AccelSensitivity}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding ApplyChangesCommand}"
                    Content="Apply changes"
                    IsEnabled="{Binding CanEditSharedConfiguration}"
                    ToolTip="{Binding SharedConfigurationToolTip}"
                    ToolTipService.InitialShowDelay="200"
                    ToolTipService.ShowOnDisabled="True" />
                <ui:Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Appearance="Secondary"
                    Command="{Binding RefreshDeviceSettingsCommand}"
                    Content="Cancel" />
            </Grid>

        </DockPanel>

        <TabControl Margin="{StaticResource MyKey_NextLineSpacement}" VerticalAlignment="Stretch">
            <TabItem Header="Info">
                <!--  Device info  -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                <DockPanel
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    LastChildFill="False">
                    <DockPanel DockPanel.Dock="Top">
                        <!--  Device Name  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Device name:" />
                            <ui:TextBox
                                HorizontalAlignment="Stretch"
                                DockPanel.Dock="Left"
                                IsReadOnly="True"
                                Text="{Binding DisplayName, Mode=OneWay}" />


                        </DockPanel>
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Controller model:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding DeviceTypeDisplay, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Diagnostics:" />
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenInputTesterCommand}"
                                    Content="Input tester"
                                    IsEnabled="{Binding CanOpenInputTester}"
                                    ToolTip="{Binding InputTesterToolTip}"
                                    ToolTipService.InitialShowDelay="200"
                                    ToolTipService.ShowOnDisabled="True" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenMotionViewerCommand}"
                                    Content="Motion viewer"
                                    IsEnabled="{Binding CanOpenMotionViewer}"
                                    ToolTip="{Binding MotionViewerToolTip}"
                                    ToolTipService.InitialShowDelay="200"
                                    ToolTipService.ShowOnDisabled="True" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenRumbleTesterCommand}"
                                    Content="Rumble tester"
                                    IsEnabled="{Binding CanOpenRumbleTester}"
                                    ToolTip="{Binding RumbleTesterToolTip}"
                                    ToolTipService.InitialShowDelay="200"
                                    ToolTipService.ShowOnDisabled="True" />
                                <ui:Button
                                    Command="{Binding OpenExportDiagnosticsCommand}"
                                    Content="Export diagnostics"
                                    ToolTip="{Binding ExportDiagnosticsToolTip}"
                                    ToolTipService.InitialShowDelay="200" />
                            </StackPanel>
                        </DockPanel>
                        <ui:InfoBar
                            Title="Hardware limits"
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            IsClosable="False"
                            IsOpen="{Binding HasDeviceCapabilityNote}"
                            Message="{Binding DeviceCapabilityNote}"
                            Severity="Informational" />
                        <ui:InfoBar
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            IsClosable="False"
                            IsOpen="{Binding IsOutputStalled}"
                            Message="{Binding OutputStallNote}"
                            Severity="Warning" />
                        <ui:InfoBar
                            Title="Outdated driver"
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            IsClosable="False"
                            IsOpen="{Binding IsDriverOutdated}"
                            Message="{Binding DriverOutdatedNote}"
                            Severity="Warning" />
                        <!--  Device MAC address  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Device address:" />
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource MyKey_SymbolFontSize}"
                                Foreground="Yellow"
                                Style="{StaticResource MyKey_StatusSymbol}"
                                Symbol="Warning24"
                                ToolTip="This device did not report its own Bluetooth address; a synthesized fallback is shown instead and Bluetooth pairing is unavailable."
                                ToolTipService.InitialShowDelay="200"
                                Visibility="{Binding IsDeviceAddressSynthesized, Converter={StaticResource BoolToVis_TV_FH}}" />

                            <ui:TextBox
                                DockPanel.Dock="Right"
                                IsReadOnly="True"
                                Text="{Binding DeviceAddressFriendly, Mode=OneWay}" />

                        </DockPanel>
                        <!--  Battery status  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Battery status:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding BatteryStatusInText}" />
                        </DockPanel>
                        <!--  Input report arrival cadence from driver IPC  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Input report rate:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding InputReportRateDisplay}"
                                ToolTip="{Binding InputReportRateToolTip}" />
                        </DockPanel>
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Average report interval:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding AverageReportIntervalDisplay}"
                                ToolTip="{Binding AverageReportIntervalToolTip}" />
                        </DockPanel>
                        <!--  Authenticity approximations: sourced-chip OUI and Feature 0x01, shown independently  -->
                        <ui:InfoBar
                            Title="Authenticity checks (best effort)"
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding AuthenticityDisclaimer}"
                            Severity="Informational" />
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Bluetooth chip vendor:" />
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource MyKey_SymbolFontSize}"
                                Foreground="Yellow"
                                Style="{StaticResource MyKey_StatusSymbol}"
                                Symbol="Warning24"
                                ToolTip="{Binding AddressVendorDetail}"
                                ToolTipService.InitialShowDelay="200"
                                Visibility="{Binding ShowAddressVendorWarning, Converter={StaticResource BoolToVis_TV_FH}}" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding AddressVendorSummary}"
                                ToolTip="{Binding AddressVendorDetail}"
                                ToolTipService.InitialShowDelay="200" />
                        </DockPanel>
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Identification data:" />
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource MyKey_SymbolFontSize}"
                                Foreground="Yellow"
                                Style="{StaticResource MyKey_StatusSymbol}"
                                Symbol="Warning24"
                                ToolTip="{Binding IdentificationCheckDetail}"
                                ToolTipService.InitialShowDelay="200"
                                Visibility="{Binding ShowIdentificationCheckWarning, Converter={StaticResource BoolToVis_TV_FH}}" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding IdentificationCheckSummary}"
                                ToolTip="{Binding IdentificationCheckDetail}"
                                ToolTipService.InitialShowDelay="200" />
                        </DockPanel>
                        <!--  Feature 0x01 identification details (USB and Bluetooth)  -->
                        <DockPanel
                            DockPanel.Dock="Top"
                            LastChildFill="False"
                            Visibility="{Binding HasIdentification, Converter={StaticResource BoolToVis_TV_FC}}">
                            <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                                <ui:TextBlock
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                    Text="Firmware revision:" />
                                <ui:TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Text="{Binding IdentificationFirmware}" />
                            </DockPanel>
                            <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                                <ui:TextBlock
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                    Text="Controller type:" />
                                <ui:TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Text="{Binding IdentificationPadType}" />
                            </DockPanel>
                            <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                                <ui:TextBlock
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                    Text="Motion path:" />
                                <ui:TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Text="{Binding IdentificationMotionPath}" />
                            </DockPanel>
                        </DockPanel>
                        <!--  Current HID mode  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Current HID mode:" />
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource MyKey_SymbolFontSize}"
                                Foreground="Yellow"
                                Style="{StaticResource MyKey_StatusSymbol}"
                                Symbol="Warning24"
                                Visibility="{Binding IsHidModeMismatched, Converter={StaticResource BoolToVis_TV_FH}}" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding HidEmulationMode, Mode=OneWay}" />
                        </DockPanel>
                        <!--  Configured Bluetooth output channel (USB and Bluetooth)  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Bluetooth output channel:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding BluetoothOutputReportTransport, Mode=OneWay}" />
                        </DockPanel>
                        <!--  XInput player slot (XInput HID mode only)  -->
                        <DockPanel
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            Visibility="{Binding IsXInputHidMode, Converter={StaticResource BoolToVis_TV_FC}}">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="XInput player slot:" />
                            <ui:TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding XInputSlotDetail}" />
                        </DockPanel>
                        <!--  Current host address  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Paired to (host address):" />
                            <ui:TextBox
                                DockPanel.Dock="Right"
                                IsReadOnly="True"
                                Text="{Binding HostAddress, Mode=OneWay}" />
                        </DockPanel>
                        <!--  Pairing mode  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Bluetooth pairing mode:" />
                            <ui:SymbolIcon
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource MyKey_SymbolFontSize}"
                                Style="{StaticResource MyKey_StatusSymbol}"
                                Symbol="{Binding LastPairingStatusIcon}"
                                Visibility="{Binding IsWireless, Converter={StaticResource BoolToVis_TH_FV}}" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Command="{Binding PairingHelpButtonPressedCommand}"
                                DockPanel.Dock="Right">
                                <ui:Button.Content>
                                    <ui:SymbolIcon
                                        DockPanel.Dock="Right"
                                        FontSize="{StaticResource MyKey_SymbolFontSize}"
                                        IsEnabled="True"
                                        Symbol="QuestionCircle24" />
                                </ui:Button.Content>
                            </ui:Button>
                            <ui:Button
                                Margin="10,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding PairNowCommand}"
                                Content="Pair now"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding CanPairNow}" />

                            <ComboBox
                                x:Name="PairingModeComboBox"
                                VerticalAlignment="Stretch"
                                IsEnabled="{Binding SupportsBluetoothPairing}"
                                SelectedValue="{Binding PairingMode}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="To this PC" Tag="{x:Static enums:BluetoothPairingMode.Auto}" />
                                <ComboBoxItem Content="Custom MAC address" Tag="{x:Static enums:BluetoothPairingMode.Custom}" />
                                <ComboBoxItem Content="Disabled" Tag="{x:Static enums:BluetoothPairingMode.Disabled}" />
                            </ComboBox>

                        </DockPanel>
                        <!--  Custom pairing address  -->
                        <DockPanel
                            Margin="{StaticResource MyKey_NextLineSpacement}"
                            DockPanel.Dock="Top"
                            IsEnabled="{Binding SupportsBluetoothPairing}">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomPairingAddressVisible}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Custom pairing address:" />
                            <ui:TextBox
                                DockPanel.Dock="Right"
                                MaxLength="20"
                                Text="{Binding CustomPairingAddress}" />
                        </DockPanel>
                    </DockPanel>


                    <DockPanel DockPanel.Dock="Bottom">
                        <!--  Last connected wirelessly  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Wireless connection time:" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding LastConnectedDisplay, Mode=OneWay}">
                                <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWireless}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                        </DockPanel>

                        <!--  Instance ID  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Driver version:" />
                            <ui:TextBox
                                DockPanel.Dock="Right"
                                IsReadOnly="True"
                                Text="{Binding DriverVersion, Mode=OneWay}" />
                        </DockPanel>

                        <!--  Instance ID  -->
                        <DockPanel Margin="{StaticResource MyKey_NextLineSpacement}" DockPanel.Dock="Top">
                            <ui:TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource MyKey_InfoDescriptionTextbox}"
                                Text="Instance ID:" />
                            <ui:TextBox
                                DockPanel.Dock="Right"
                                IsReadOnly="True"
                                Text="{Binding InstanceId, Mode=OneWay}" />
                        </DockPanel>


                    </DockPanel>

                </DockPanel>
                </ScrollViewer>


            </TabItem>
            <TabItem Header="Configure">
                <!--  Device settings  -->


                <DockPanel Margin="10" LastChildFill="True">


                    <ui:Card
                        Margin="{StaticResource MyKey_NextLineSpacement}"
                        VerticalAlignment="Stretch"
                        DockPanel.Dock="Top">
                        <!--  Top settings mode choose  -->
                        <DockPanel
                            VerticalAlignment="Stretch"
                            DockPanel.Dock="Top"
                            LastChildFill="True">
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Text="Settings mode: " />
                            <ComboBox
                                x:Name="SettingsModeSelection_ComboBox"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                IsEnabled="{Binding CanEditSharedConfiguration}"
                                ItemsSource="{Binding Source={helpers:EnumBindingSource {x:Type enums:SettingsModes}}}"
                                SelectedItem="{Binding CurrentDeviceSettingsMode}"
                                ToolTip="{Binding SharedConfigurationToolTip}"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.ShowOnDisabled="True" />
                            <ui:SymbolIcon
                                Margin="10,0,10,0"
                                DockPanel.Dock="Left"
                                FontSize="25"
                                Symbol="ArrowRight24"
                                Visibility="{Binding IsProfileSelectorVisible, Converter={StaticResource BoolToVis}}" />
                            <ComboBox
                                x:Name="ProfileSelection_ComboBox"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                IsEnabled="{Binding IsProfileSelectorEnabled}"
                                ItemsSource="{Binding ListOfProfiles}"
                                SelectedItem="{Binding SelectedProfile}"
                                Visibility="{Binding IsProfileSelectorVisible, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ui:Card>

                    <ui:CardExpander
                        Margin="0,0,0,12"
                        Padding="16,8"
                        DockPanel.Dock="Top"
                        DataContext="{Binding DeviceCustomsVM}"
                        Header="Cemuhook UDP Bridge &amp; Motion Controls configuration">
                        <ui:CardExpander.Content>
                            <DockPanel Margin="0,8,0,0">
                                <ui:InfoBar
                                    Margin="0,0,0,8"
                                    DockPanel.Dock="Top"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="Settings are saved per-controller. Each connected controller has its own UDP port and motion controls configuration."
                                    Severity="Informational" />
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding CemuhookGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="CemuhookModeSetting" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </ui:CardExpander.Content>
                    </ui:CardExpander>

                    <ContentControl Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">
                        <local:DeviceSettingsEditor
                            VerticalAlignment="Stretch"
                            DataContext="{Binding DeviceCustomsVM}"
                            DockPanel.Dock="Top" />
                    </ContentControl>

                </DockPanel>


            </TabItem>
        </TabControl>

    </DockPanel>


</UserControl>
