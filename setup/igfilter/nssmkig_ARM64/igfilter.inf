[Version]
Signature = "$WINDOWS NT$"
Class = HIDClass
ClassGuid = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %ManufacturerName%
CatalogFile = igfilter.cat
DriverVer = 05/03/2024,1.1.1.0
PnpLockdown = 1
 

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
nssmkig.sys  = 1,,

[DestinationDirs]
DefaultDestDir = 12
Nssmkig.DriverFiles = 12

[DefaultInstall.NTARM64]
OptionDesc = %NssmkigServiceDesc%
CopyFiles = Nssmkig.DriverFiles

[DefaultUninstall.NTARM64]
LegacyUninstall = 1

[Nssmkig.DriverFiles]
nssmkig.sys

[DefaultInstall.NTARM64.Services]
AddService = %NssmkigServiceName%,,Nssmkig.Service

[Nssmkig.Service]
DisplayName    = %NssmkigServiceName%
Description    = %NssmkigServiceDesc%
ServiceBinary  = %12%\Nssmkig.sys
ServiceType    = 1 ;    SERVICE_KERNEL_DRIVER
StartType      = 3 ;    SERVICE_DEMAND_START
ErrorControl   = 1 ;    SERVICE_ERROR_NORMAL
 
[Strings]
ManufacturerName = "Nefarius Software Solutions e.U." 
DiskName = "nssmkig Installation Disk"
NssmkigServiceDesc = "Nefarius XInput HID Devices filter driver"
NssmkigServiceName = "nssmkig"
